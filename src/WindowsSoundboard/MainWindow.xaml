<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsSoundboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WindowsSoundboard.Models"
    Title="Windows Soundboard">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command row -->
        <Grid Grid.Row="0" Padding="20,16,20,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="FolderButton" Grid.Column="0" Click="OnChooseFolderClicked" ToolTipService.ToolTip="Pick the folder that holds your sounds">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Sounds folder" />
                </StackPanel>
            </Button>

            <Button x:Name="ModeButton" Grid.Column="1" Click="OnModeClicked" ToolTipService.ToolTip="How a hotkey starts a sound">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ModeIcon" Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock x:Name="ModeLabel" Text="Play &amp; Stop" />
                </StackPanel>
            </Button>

            <Button x:Name="PlayModeButton" Grid.Column="2" Click="OnPlayModeClicked" ToolTipService.ToolTip="What happens when a sound ends">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EF;" FontSize="14" />
                    <TextBlock x:Name="PlayModeLabel" Text="Default" />
                </StackPanel>
            </Button>

            <Button
                x:Name="StopAllButton"
                Grid.Column="3"
                Click="OnStopAllClicked"
                ToolTipService.ToolTip="Stop every playing sound">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop all" />
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="ModeHint"
                Grid.Column="4"
                VerticalAlignment="Center"
                Opacity="0.6"
                TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="5" VerticalAlignment="Center" Opacity="0.6" Text="Output" />
            <ComboBox
                x:Name="DeviceCombo"
                Grid.Column="6"
                MinWidth="250"
                SelectionChanged="OnDeviceChanged" />

            <Button
                x:Name="SettingsButton"
                Grid.Column="7"
                Click="OnSettingsClicked"
                ToolTipService.ToolTip="Options">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Microphone row -->
        <Grid Grid.Row="1" Padding="20,0,20,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleSwitch
                x:Name="MicSwitch"
                MinWidth="0"
                OffContent="Mic passthrough"
                OnContent="Mic passthrough"
                Toggled="OnMicToggled" />

            <ComboBox
                x:Name="MicCombo"
                Grid.Column="1"
                MinWidth="280"
                SelectionChanged="OnMicChanged" />

            <TextBlock
                x:Name="MicHint"
                Grid.Column="2"
                VerticalAlignment="Center"
                Opacity="0.6"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Sound board -->
        <Grid Grid.Row="2">
            <GridView
                x:Name="SoundGrid"
                Padding="14,0,14,14"
                IsItemClickEnabled="False"
                SelectionMode="None"
                RightTapped="OnSoundRightTapped">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="28" FromVerticalOffset="28" />
                        <RepositionThemeTransition />
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:SoundItem">
                        <Grid Width="196" Height="92" Margin="5">
                            <Button
                                Padding="14,12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnPlayClicked"
                                ToolTipService.ToolTip="{x:Bind Path}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="15"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Top" />
                                    <Grid Grid.Row="1" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind HotkeyText, Mode=OneWay}"
                                            FontSize="12"
                                            Opacity="0.65"
                                            TextTrimming="CharacterEllipsis" />
                                        <ProgressRing
                                            Grid.Column="1"
                                            Width="14"
                                            Height="14"
                                            IsActive="True"
                                            Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind ClipText, Mode=OneWay}"
                                            FontSize="11"
                                            Opacity="0.7" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind PlayModeText, Mode=OneWay}"
                                            FontSize="11"
                                            Opacity="0.5" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{x:Bind GainText, Mode=OneWay}"
                                            FontSize="11"
                                            Opacity="0.45" />
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnAssignClicked"
                                ToolTipService.ToolTip="Set hotkey">
                                <FontIcon Glyph="&#xE765;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView
                x:Name="SoundList"
                Padding="14,0,14,14"
                Visibility="Collapsed"
                IsItemClickEnabled="True"
                ItemClick="OnSoundItemClick"
                SelectionMode="None"
                RightTapped="OnSoundRightTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SoundItem">
                        <Grid Padding="4,2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Name}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.5"
                                Text="{x:Bind PlayModeText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.65"
                                Text="{x:Bind HotkeyText, Mode=OneWay}" />
                            <ProgressRing
                                Grid.Column="3"
                                Width="14"
                                Height="14"
                                IsActive="True"
                                Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.45"
                                Text="{x:Bind GainText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.7"
                                Text="{x:Bind ClipText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE8D6;" FontSize="36" Opacity="0.5" />
                <TextBlock Text="No sounds yet" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Drop audio files into your sounds folder, or pick a different one."
                    Opacity="0.6"
                    TextAlignment="Center"
                    MaxWidth="360"
                    TextWrapping="Wrap" />
                <Button Content="Choose folder" HorizontalAlignment="Center" Click="OnChooseFolderClicked" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8" Margin="20,0,20,8">
            <!-- Screen-share routing warning -->
            <InfoBar
                x:Name="RoutingWarning"
                Severity="Warning"
                IsOpen="False"
                IsClosable="True"
                Title="Screen shares will hear the board"
                Message="This output is the Windows default playback device, and Discord's screen-share audio is a loopback of that device. Muting your microphone does not touch it — use Mute Output, or play the board into the virtual cable instead." />

            <!-- Hotkeys cannot see an elevated app's keystrokes -->
            <InfoBar
                x:Name="ElevationWarning"
                Severity="Informational"
                IsOpen="False"
                IsClosable="True"
                Title="Global hotkeys cannot see keys typed into elevated apps"
                Message="The window in front is running as administrator, so Windows hides its keystrokes from this app. Restart Windows Soundboard as administrator to make hotkeys work there.">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" Click="OnRestartElevatedClicked" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="4" Padding="20,6,20,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Opacity="0.7"
                TextTrimming="CharacterEllipsis" />
            <ToggleSwitch
                x:Name="NormaliseSwitch"
                Grid.Column="1"
                MinWidth="0"
                OffContent="Normalise"
                OnContent="Normalise"
                ToolTipService.ToolTip="Even out the loudness of every sound"
                Toggled="OnNormaliseToggled" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6" Text="Volume" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="3"
                Width="160"
                Maximum="150"
                Minimum="0"
                StepFrequency="5"
                ValueChanged="OnVolumeChanged" />
        </Grid>
    </Grid>
</Window>

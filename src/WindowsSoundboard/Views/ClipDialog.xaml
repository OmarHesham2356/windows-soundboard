<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindowsSoundboard.Views.ClipDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit clip"
    PrimaryButtonText="Save"
    SecondaryButtonText="Reset"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel MinWidth="560" Spacing="10">
        <TextBlock x:Name="HeaderText" Opacity="0.75" TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Canvas x:Name="WaveCanvas" Height="110" SizeChanged="OnWaveSizeChanged" />
        </Border>

        <TextBlock x:Name="RangeText" FontSize="12" Opacity="0.7" />

        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Start" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Slider
                x:Name="StartSlider"
                Grid.Column="1"
                StepFrequency="0.01"
                ValueChanged="OnStartChanged" />
            <TextBlock x:Name="StartText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />

            <TextBlock Grid.Row="1" Text="End" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Slider
                x:Name="EndSlider"
                Grid.Row="1"
                Grid.Column="1"
                StepFrequency="0.01"
                ValueChanged="OnEndChanged" />
            <TextBlock x:Name="EndText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />

            <TextBlock Grid.Row="2" Text="Gain" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Slider
                x:Name="GainSlider"
                Grid.Row="2"
                Grid.Column="1"
                Maximum="24"
                Minimum="-24"
                StepFrequency="0.5"
                ValueChanged="OnGainChanged" />
            <TextBlock x:Name="GainText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />

            <TextBlock Grid.Row="3" Text="Fade in" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Slider
                x:Name="FadeInSlider"
                Grid.Row="3"
                Grid.Column="1"
                Maximum="2000"
                Minimum="0"
                StepFrequency="10"
                ValueChanged="OnFadeInChanged" />
            <TextBlock x:Name="FadeInText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />

            <TextBlock Grid.Row="4" Text="Fade out" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Slider
                x:Name="FadeOutSlider"
                Grid.Row="4"
                Grid.Column="1"
                Maximum="2000"
                Minimum="0"
                StepFrequency="10"
                ValueChanged="OnFadeOutChanged" />
            <TextBlock x:Name="FadeOutText" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Preview" Click="OnPreviewClicked" />
            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="The file itself is never changed — Reset restores it." />
        </StackPanel>
    </StackPanel>
</ContentDialog>

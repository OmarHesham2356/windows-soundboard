<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindowsSoundboard.Views.HotkeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set hotkey"
    PrimaryButtonText="Save"
    SecondaryButtonText="Clear"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel MinWidth="380" Spacing="14">
        <TextBlock x:Name="TargetText" Opacity="0.75" TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18,22">
            <TextBlock
                x:Name="KeyText"
                HorizontalAlignment="Center"
                FontSize="20"
                Text="Press a key combination…" />
        </Border>

        <TextBlock
            FontSize="12"
            Opacity="0.6"
            TextWrapping="Wrap"
            Text="Hold Ctrl, Alt, Shift or Win and then press the last key — combinations work, so Ctrl+Shift+F1 is a valid hotkey. Escape cancels recording, Clear removes the hotkey." />
    </StackPanel>
</ContentDialog>
